# Server-only. Copy to .env; never commit keys or credentials.
# In development the browser uses Vite (5173) and proxies /api to Node (8787).
APP_ORIGIN=http://127.0.0.1:5173
PORT=8787
GITHUB_APP_ID=5506935
GITHUB_APP_CLIENT_ID=Iv23liuSlQBY4hKFPGFD
GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/github-app.private-key.pem
# Hosted/serverless: use GITHUB_APP_PRIVATE_KEY (PEM, real newlines or escaped \n).
GITHUB_DATA_OWNER=BrclioData
GITHUB_PROGRAM_REPO=Brclio-LingoTiles-Data
GITHUB_USER_REPO=Brclio-LingoTiles-UserData
GITHUB_DATA_BRANCH=main
# Generate e.g. node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Separate Google Web application OAuth credentials, not the GitHub App client ID.
# Allowed redirect URI: <APP_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set true ONLY behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
